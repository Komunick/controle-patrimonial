# Exemplo sem segredos. O instalador cria /etc/controle-patrimonial/sistema.env.
PORT=8080
HOST=0.0.0.0
PAT_DATA_DIR=/var/lib/controle-patrimonial
PAT_LINK_ASSINATURA=https://seu-relay.onrender.com
# Veículos do TMS: conta do TMS com perfil de Coordenador de frota (só leitura
# é o uso previsto). Sem estas duas linhas a aba Veículos fica vazia.
