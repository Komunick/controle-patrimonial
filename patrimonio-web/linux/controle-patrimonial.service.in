[Unit]
Description=Controle Patrimonial Web
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@@USUARIO@@
Group=@@GRUPO@@
WorkingDirectory=@@PASTA_WEB@@
EnvironmentFile=/etc/controle-patrimonial/sistema.env
ExecStart=@@NODE@@ @@PASTA_WEB@@/server/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077

# O processo pode ler o código, mas só grava no diretório de dados dedicado.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/controle-patrimonial
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
