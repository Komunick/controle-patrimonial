[Unit]
Description=Sincronizador do relay de assinaturas de EPI
Wants=network-online.target
After=network-online.target controle-patrimonial.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@@USUARIO@@
Group=@@GRUPO@@
WorkingDirectory=@@PASTA_WEB@@
EnvironmentFile=/etc/controle-patrimonial/relay.env
ExecStart=@@NODE@@ @@PASTA_WEB@@/server/sincroniza-relay.js
Restart=always
RestartSec=15
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0077

# O sincronizador só precisa ler o código e acessar as duas APIs por rede.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
